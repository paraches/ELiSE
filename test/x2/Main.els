/*
    test x2 in Array's index calc
    copy from nand2tetris ArrayTest
 */
class Main {
    function void main() {
        var Array r;                  // stores test results
        var Array a, b, c;

        r = Array.new(4);
        Output.printIntHexLn(r);

        a = Array.new(3);
        Output.printIntHexLn(a);
        a[2] = 222;
        r[0] = a[2];              // RAM[8000] = 222
        Output.printIntLn(r[0]);

        b = Array.new(3);
        Output.printIntHexLn(b);
        b[1] = a[2] - 100;
        r[1] = b[1];              // RAM[8001] = 122
        Output.printIntLn(r[1]);

        c = Array.new(500);
        Output.printIntHexLn(c);
        c[499] = a[2] - b[1];
        r[2] = c[499];            // RAM[8002] = 100
        Output.printIntLn(r[2]);

        a.deAlloc();
        b.deAlloc();

        b = Array.new(3);
        Output.printIntHexLn(b);
        b[0] = c[499] - 90;
        r[3] = b[0];              // RAM[8003] = 10
        Output.printIntLn(r[3]);

        c.deAlloc();
        b.deAlloc();

        return;
    }
}
