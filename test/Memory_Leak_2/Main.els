class Main {
    function void main() {
	    var int i, j;

        Main.mem_set();
        Debug.setMemFreeList(0xC00A); // ok

	    i = Memory.alloc(5);
	    Output.printIntHexLn(i);    // 0xC01C

        Debug.memDump(0xc000, 8);
        j = Debug.memFreeList();
        Output.printIntHexLn(j);    // 0xC00A

        Output.printIntHexLn(Debug.freeHeap()); // 0x0FE0

        Debug.showReg();

        Debug.showSP();

        return;
    }

    function void mem_set() {
        var int i, value;
        var int d;
        dat d = db  0x00, 0x00, 0x06, 0x00, 0x53, 0x58, 0x5f, 0x30,
                    0x34, 0x20, 0x14, 0xc0, 0x06, 0x00, 0x01, 0x00,
                    0x02, 0x70, 0x00, 0xa0, 0x18, 0xc0, 0x00, 0x00,
                    0x00, 0x00, 0xe8, 0x0f, 0x00, 0x00, 0x18, 0x10;

        i = 0;
        while (i < 0x20) {
            value = Memory.peek8(d + i);
            Memory.poke8(0xC000 + i, value);
            i = ++i;
        }

        return;
    }
}
